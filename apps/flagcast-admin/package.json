{
  "name": "flagcast-admin",
  "productName": "Flagcast Admin",
  "version": "2.2.0",
  "description": "Flagcast Admin: set up clubs, give them tournaments, approve and switch off clubs.",
  "main": "main.js",
  "author": "Flagcast",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac --arm64 --x64",
    "dist:win": "electron-builder --win --x64"
  },
  "devDependencies": {
    "electron": "38.8.6",
    "electron-builder": "26.0.12"
  },
  "build": {
    "appId": "app.flagcast.admin",
    "productName": "Flagcast Admin",
    "files": [
      "main.js",
      "updater.js",
      "build/icon.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon-mac.png",
      "hardenedRuntime": true,
      "artifactName": "Flagcast-Admin-${version}-${arch}-mac.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "Flagcast-Admin-Setup-${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Flagcast-Admin-Setup-${version}.exe"
    },
    "dmg": {
      "artifactName": "Flagcast-Admin-${version}-universal.dmg"
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://flagcast.app/updates/admin"
      }
    ],
    "extraResources": [
      {
        "from": "build/app-update.yml",
        "to": "app-update.yml"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
